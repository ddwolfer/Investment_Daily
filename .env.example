# ========== Telegram Bot ==========
# Bot Token: 與 @BotFather 對話建立 Bot 後取得
# Chat ID: 發訊給 Bot 後用 getUpdates API 查詢
# Topic ID: 可選，Telegram 群組的 Topic ID（執行 test_script/get_topic_id.py 取得）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# ========== LLM API ==========
# Gemini API Key: 到 https://aistudio.google.com/app/apikey 取得
# OpenAI API Key: 可選，目前未使用（保留供未來擴充）
GEMINI_API_KEY=
OPENAI_API_KEY=

# ========== Google Sheets ==========
# Sheet ID: 從試算表網址複製，格式：https://docs.google.com/spreadsheets/d/{THIS_IS_ID}/edit
# Range: Sheet 頁簽名稱與範圍，預設為 總損益!A:Z
# Credentials: Google Service Account JSON 金鑰檔案名稱（需放在專案根目錄）
GOOGLE_SHEET_ID_STOCK=
GOOGLE_SHEET_ID_CRYPTO=
GOOGLE_SHEET_RANGE=總損益!A:Z
GOOGLE_CREDENTIALS_FILE=credentials.json
